---
import cookMedical from '../../assets/logos/cook-medical-logo.webp';
import geHealthcare from '../../assets/logos/ge-healthcare-logo.webp';
import ferrosan from '../../assets/logos/ferrosan-medical-devices-logo.svg';
import novo from '../../assets/logos/novo-logo.png';
import medicoindustrien from '../../assets/logos/medicoindustrien-logo.webp';

const companies = [
  { name: 'Cook Medical', logoSrc: cookMedical, website: 'https://www.cookmedical.com' },
  { name: 'GE HealthCare', logoSrc: geHealthcare, website: 'https://www.gehealthcare.dk' },
  { name: 'Ferrosan Medical Devices', logoSrc: ferrosan, website: 'https://www.ferrosanmedicaldevices.com' },
  { name: 'Novo', logoSrc: novo, website: 'https://www.novonordisk.com' },
];
---

<section class="companies">
  <div class="companies__inner">
    <p class="companies__eyebrow">MedTech Career Day 2026</p>
    <h2>Meet This Year's Companies</h2>
    <p class="companies__intro">
      Talk directly with representatives from Cook Medical, GE HealthCare, Ferrosan Medical Devices
      and Novo, and explore your future career in MedTech.
    </p>
    <div class="companies__grid">
      {companies.map((company) => (
        <a href={company.website} target="_blank" rel="noopener noreferrer" class="companies__card">
          <div class="companies__logo">
            <img
              src={company.logoSrc.src}
              alt={`${company.name} logo`}
              width={company.logoSrc.width}
              height={company.logoSrc.height}
              loading="lazy"
            />
          </div>
          <h3 class="companies__name">{company.name}</h3>
        </a>
      ))}
    </div>
    <a href="https://www.medicoindustrien.dk" target="_blank" rel="noopener noreferrer" class="companies__collab">
      <span>In collaboration with</span>
      <img
        src={medicoindustrien.src}
        alt="Medicoindustrien logo"
        width={medicoindustrien.width}
        height={medicoindustrien.height}
        loading="lazy"
      />
    </a>
  </div>
</section>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/mixins' as *;

  .companies {
    padding: 4rem 0;
    background-color: rgba($color-primary, 0.05);
  }

  .companies__inner {
    @include container(72rem);
    text-align: center;

    h2 {
      margin-bottom: 0.75rem;
    }
  }

  .companies__eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: $color-primary;
    margin-bottom: 0.5rem;
  }

  .companies__intro {
    color: $color-muted-fg;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  .companies__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 2.5rem;

    @include respond-to($bp-md) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .companies__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    background-color: $color-card;
    border: 1px solid $color-border;
    border-top: 4px solid $color-primary;
    border-radius: $radius-lg;
    padding: 2rem 1rem 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: $transition-smooth;

    &:hover {
      box-shadow: $shadow-medium;
      transform: translateY(-2px);
    }
  }

  .companies__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.5rem;
    width: 100%;

    img {
      max-height: 100%;
      max-width: 85%;
      object-fit: contain;
    }
  }

  .companies__name {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .companies__collab {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: $color-muted-fg;
    font-size: 0.875rem;
    text-decoration: none;

    img {
      height: 2.5rem;
      width: auto;
    }
  }
</style>
